# ==========================================
# Banking Copilot - Environment Configuration
# ==========================================

# Database
# Default: sqlite+aiosqlite:///./banking_copilot.db (Zero-config local setup)
# For PostgreSQL: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/banking_copilot
DATABASE_URL=sqlite+aiosqlite:///./banking_copilot.db
ECHO_SQL=false

# Security & JWT
SECRET_KEY=banking-copilot-dev-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# LLM Provider Configuration
# Options: "auto" | "gemini" | "openai" | "azure" | "local"
# Priority order in "auto" mode: Gemini -> OpenAI -> Azure -> Local Engine
# ==========================================
LLM_PROVIDER=auto

# 1. Google Gemini (Recommended - Priority 1)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 2. OpenAI (Priority 2)
# Get a key at: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 3. Azure OpenAI (Priority 3)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-01
